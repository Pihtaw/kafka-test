[
  {
    "name": "валидное OrderCreated, пакет 1.0.0",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":1,\"amount\":500}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "валидное OrderCreated, пакет 1.1.0 (с Currency)",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.1.0"
      }
    ],
    "payload": "{\"orderId\":2,\"amount\":700,\"currency\":\"RUB\"}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "валидное OrderCancelled",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCancelled"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":1,\"reason\":\"client\"}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "нет заголовка Event-Type",
    "headers": [
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":3,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "MissingEventType"
  },
  {
    "name": "нет Event-PackageVersion — версия только для отчёта, событие читается",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      }
    ],
    "payload": "{\"orderId\":4,\"amount\":100}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "Event-Type пустая строка",
    "headers": [
      {
        "key": "Event-Type",
        "value": ""
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":11,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "EmptyHeader"
  },
  {
    "name": "Event-Type из пробелов",
    "headers": [
      {
        "key": "Event-Type",
        "value": "   "
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":12,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "EmptyHeader"
  },
  {
    "name": "Event-PackageVersion без значения (null)",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion"
      }
    ],
    "payload": "{\"orderId\":13,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "EmptyHeader"
  },
  {
    "name": "Event-Type не UTF-8 (байт 0xFF)",
    "headers": [
      {
        "key": "Event-Type",
        "valueBase64": "/w=="
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":14,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "InvalidHeaderEncoding"
  },
  {
    "name": "Event-Type дважды с разными значениями",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      },
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCancelled"
      }
    ],
    "payload": "{\"orderId\":15,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "DuplicateHeader"
  },
  {
    "name": "Event-Type дважды с одинаковым значением",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      },
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      }
    ],
    "payload": "{\"orderId\":16,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "DuplicateHeader"
  },
  {
    "name": "чужое событие мультитопика",
    "headers": [
      {
        "key": "Event-Type",
        "value": "Dodo.Payments.Contracts.PaymentCaptured"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"paymentId\":5}",
    "expectedVerdict": "Skipped",
    "expectedReason": "NotOurEvent"
  },
  {
    "name": "чужое событие без Event-PackageVersion — всё равно пропуск",
    "headers": [
      {
        "key": "Event-Type",
        "value": "Dodo.Delivery.Contracts.CourierAssigned"
      }
    ],
    "payload": "{\"courierId\":7}",
    "expectedVerdict": "Skipped",
    "expectedReason": "NotOurEvent"
  },
  {
    "name": "незнакомая версия пакета — тип тот же, событие читается",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "2.0.0"
      }
    ],
    "payload": "{\"orderId\":6,\"amount\":100}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "битый JSON",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":7,\"amount\":",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "неверный тип поля",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":8,\"amount\":\"много\"}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "без необязательного Currency (старое событие) — читается",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.1.0"
      }
    ],
    "payload": "{\"orderId\":9,\"amount\":100}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "лишнее поле, которого нет в DTO",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":10,\"amount\":100,\"comment\":\"hi\"}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "OrderCancelled без reason",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCancelled"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":5}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "пустое тело (не tombstone)",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "Event-PackageVersion дважды с одинаковым значением",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":17,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "DuplicateHeader"
  },
  {
    "name": "Event-Type в другом регистре (полное имя)",
    "headers": [
      {
        "key": "Event-Type",
        "value": "messagecheck.samplecontracts.ordercreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":18,\"amount\":100}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "tombstone с заголовками",
    "headers": [
      {
        "key": "Event-Type",
        "value": "MessageCheck.SampleContracts.OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": null,
    "expectedVerdict": "Skipped",
    "expectedReason": "Tombstone"
  },
  {
    "name": "tombstone без заголовков",
    "headers": [],
    "payload": null,
    "expectedVerdict": "Skipped",
    "expectedReason": "Tombstone"
  },
  {
    "name": "короткое имя типа без namespace — чужое событие",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1.0.0"
      }
    ],
    "payload": "{\"orderId\":19,\"amount\":100}",
    "expectedVerdict": "Skipped",
    "expectedReason": "NotOurEvent"
  }
]
