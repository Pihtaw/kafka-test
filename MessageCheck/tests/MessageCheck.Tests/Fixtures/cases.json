[
  {
    "name": "валидное OrderCreated v1",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":1,\"amount\":500}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "валидное OrderCreated v2",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "2"
      }
    ],
    "payload": "{\"orderId\":2,\"amount\":700,\"currency\":\"RUB\"}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "валидное OrderCancelled v1",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCancelled"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":1,\"reason\":\"client\"}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "нет заголовка eventType",
    "headers": [
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":3,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "MissingEventType"
  },
  {
    "name": "нет заголовка version",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      }
    ],
    "payload": "{\"orderId\":4,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "MissingVersion"
  },
  {
    "name": "eventType пустая строка",
    "headers": [
      {
        "key": "Event-Type",
        "value": ""
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":11,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "EmptyHeader"
  },
  {
    "name": "eventType из пробелов",
    "headers": [
      {
        "key": "Event-Type",
        "value": "   "
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":12,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "EmptyHeader"
  },
  {
    "name": "version без значения (null)",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion"
      }
    ],
    "payload": "{\"orderId\":13,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "EmptyHeader"
  },
  {
    "name": "eventType не UTF-8 (байт 0xFF)",
    "headers": [
      {
        "key": "Event-Type",
        "valueBase64": "/w=="
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":14,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "InvalidHeaderEncoding"
  },
  {
    "name": "eventType дважды с разными значениями",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      },
      {
        "key": "Event-Type",
        "value": "OrderCancelled"
      }
    ],
    "payload": "{\"orderId\":15,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "DuplicateHeader"
  },
  {
    "name": "eventType дважды с одинаковым значением",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      },
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      }
    ],
    "payload": "{\"orderId\":16,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "DuplicateHeader"
  },
  {
    "name": "чужое событие мультитопика",
    "headers": [
      {
        "key": "Event-Type",
        "value": "PaymentCaptured"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"paymentId\":5}",
    "expectedVerdict": "Skipped",
    "expectedReason": "NotOurEvent"
  },
  {
    "name": "чужое событие без version — всё равно пропуск",
    "headers": [
      {
        "key": "Event-Type",
        "value": "CourierAssigned"
      }
    ],
    "payload": "{\"courierId\":7}",
    "expectedVerdict": "Skipped",
    "expectedReason": "NotOurEvent"
  },
  {
    "name": "наш тип, неизвестная версия",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "3"
      }
    ],
    "payload": "{\"orderId\":6,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "UnknownVersion"
  },
  {
    "name": "битый JSON",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":7,\"amount\":",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "неверный тип поля",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":8,\"amount\":\"много\"}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "v2 без обязательного currency",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "2"
      }
    ],
    "payload": "{\"orderId\":9,\"amount\":100}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "лишнее поле, которого нет в DTO",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":10,\"amount\":100,\"comment\":\"hi\"}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "OrderCancelled без reason",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCancelled"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":5}",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "пустое тело (не tombstone)",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "",
    "expectedVerdict": "ConversionError",
    "expectedReason": "InvalidPayload"
  },
  {
    "name": "version дважды с одинаковым значением",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":17,\"amount\":100}",
    "expectedVerdict": "Rejected",
    "expectedReason": "DuplicateHeader"
  },
  {
    "name": "eventType в другом регистре",
    "headers": [
      {
        "key": "Event-Type",
        "value": "orderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": "{\"orderId\":18,\"amount\":100}",
    "expectedVerdict": "Allowed",
    "expectedReason": "Ok"
  },
  {
    "name": "tombstone с заголовками",
    "headers": [
      {
        "key": "Event-Type",
        "value": "OrderCreated"
      },
      {
        "key": "Event-PackageVersion",
        "value": "1"
      }
    ],
    "payload": null,
    "expectedVerdict": "Skipped",
    "expectedReason": "Tombstone"
  },
  {
    "name": "tombstone без заголовков",
    "headers": [],
    "payload": null,
    "expectedVerdict": "Skipped",
    "expectedReason": "Tombstone"
  }
]
